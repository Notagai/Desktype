<Window x:Class="Desktype.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updating Desktype" Width="420" Height="170"
        MinWidth="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F5F2FB" FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Updating Desktype" FontSize="17" FontWeight="SemiBold"
                   Foreground="#221A33"/>
        <TextBlock x:Name="StatusLabel" Grid.Row="1" Margin="0,12,0,8"
                   Text="Preparing update…" FontSize="12" Foreground="#6D6580"
                   TextTrimming="CharacterEllipsis"/>
        <ProgressBar x:Name="DownloadProgress" Grid.Row="2" Height="12"
                     Minimum="0" Maximum="100" IsIndeterminate="True"/>
        <TextBlock x:Name="ProgressLabel" Grid.Row="3" Margin="0,8,0,0"
                   Text="Please keep this window open." FontSize="11"
                   Foreground="#6D6580" VerticalAlignment="Top"/>
    </Grid>
</Window>