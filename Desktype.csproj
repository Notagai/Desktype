    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Desktype</AssemblyName>
    <Version>1.3.1</Version>
    <ApplicationIcon>logo\Desktype.ico</ApplicationIcon>
    <RootNamespace>Desktype</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="logo\Desktype Logo.png" />
    <Resource Include="logo\Desktype.ico" />
  </ItemGroup>
</Project>
