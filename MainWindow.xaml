<Window x:Class="Desktype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktype" Height="650" Width="760"
        MinHeight="560" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{StaticResource Canvas}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="DESKTYPE" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource Accent}"/>
                <TextBlock Text="Type anywhere." FontSize="34" FontWeight="Bold"
                           Foreground="{StaticResource Ink}" Margin="0,7,0,5"/>
                <TextBlock Text="Always on top · Use a global hotkey to type instantly."
                           FontSize="14" Foreground="{StaticResource Muted}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16"
                Margin="0,0,0,16" BorderBrush="#E5E9E3" BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="YOUR TEXT" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Muted}" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="CharacterCount" Text="0 characters" FontSize="11"
                               Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                </DockPanel>
                <TextBox x:Name="InputText" Margin="0,10,0,0" MinHeight="180"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Padding="0" FontSize="15" Foreground="#26332C"
                         Background="White" CaretBrush="{StaticResource Accent}"
                         TextChanged="InputText_TextChanged"
                         AutomationProperties.Name="Text to type"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#EAF0E9" CornerRadius="10" Padding="16"
                Margin="0,0,0,18" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="HOW IT WORKS" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource Accent}" Margin="0,0,0,7"/>
                <TextBlock Text="1. Enter or edit your text.&#10;2. Click Change hotkey and press a function key (F1–F11 or F13–F24).&#10;3. Click into a text field in another app, then press your hotkey. Typing starts immediately."
                           FontSize="13" LineHeight="23" Foreground="{StaticResource Ink}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Ready when you are." FontSize="13"
                           FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="StatusDetail" Text="Default hotkey: F11"
                           FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="StopButton" Grid.Column="1" Content="Stop" Width="100"
                    Margin="8,0,0,0" Background="#E8EBE7" Foreground="{StaticResource Ink}"
                    IsEnabled="False" Click="StopButton_Click"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Tip: test in Notepad first."
                       Foreground="{StaticResource Muted}" FontSize="12"/>
            <Button x:Name="HotkeyButton" Grid.Column="1" Content="Change hotkey · F11"
                    Background="{StaticResource Accent}" Foreground="White"
                    Click="HotkeyButton_Click" MinWidth="190"/>
        </Grid>
    </Grid>
</Window>