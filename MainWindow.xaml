<Window x:Class="Desktype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktype" Height="270" Width="460"
        MinHeight="190" MinWidth="320"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#F5F2FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#221A33"/>
            <Setter Property="Background" Value="#FFFDFF"/>
            <Setter Property="BorderBrush" Value="#DDD6EC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="#6B4CE6"/>
            <Setter Property="SelectionBrush" Value="#6B4CE6"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#6B4CE6"/>
            <Setter Property="BorderBrush" Value="#221A33"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="InputText" Grid.Row="0"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" MinHeight="60" FontSize="14"
                 TextChanged="InputText_TextChanged"
                 AutomationProperties.Name="Text to type"
                 ToolTip="Enter the text to type into the focused app."/>
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="WPM" VerticalAlignment="Center"
                       Margin="0,0,6,0" Foreground="#6D6580" FontSize="12"/>
            <TextBox x:Name="WpmInput" Grid.Column="1" Text="60"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                     Padding="4,3" FontSize="12" MaxLength="4"
                     ToolTip="Target typing pace (5 characters = 1 word)."/>
            <TextBlock x:Name="StatusText" Grid.Column="2" Text=""
                       VerticalAlignment="Center" Margin="8,0"
                       FontSize="11" Foreground="#6D6580" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="HotkeyButton" Grid.Column="3"
                    Content="Hotkey: F11" FontSize="12"
                    Click="HotkeyButton_Click"/>
        </Grid>
    </Grid>
</Window>