<Window x:Class="Desktype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktype" Height="260" Width="440"
        MinHeight="180" MinWidth="300"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#F4F6F2"
        FontFamily="Segoe UI">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="InputText" Grid.Row="0"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 MinHeight="60" Padding="8" FontSize="14"
                 Foreground="#26332C" Background="White"
                 BorderBrush="#D5DDD3" BorderThickness="1"
                 CaretBrush="#39734C"
                 TextChanged="InputText_TextChanged"
                 AutomationProperties.Name="Text to type"
                 ToolTip="Enter the text to type into the focused app."/>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="WPM" VerticalAlignment="Center"
                       Margin="0,0,6,0" Foreground="#344239" FontSize="12"/>
            <TextBox x:Name="WpmInput" Grid.Column="1" Text="60"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                     Padding="4,3" FontSize="12" MaxLength="4"
                     ToolTip="Typing speed in words per minute (5 characters = 1 word)."/>
            <TextBlock x:Name="StatusText" Grid.Column="2" Text=""
                       VerticalAlignment="Center" Margin="8,0"
                       FontSize="11" Foreground="#647166" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="HotkeyButton" Grid.Column="3"
                    Content="Hotkey: F11" Padding="10,6" FontSize="12"
                    FontWeight="SemiBold" Cursor="Hand"
                    Background="#39734C" Foreground="White" BorderThickness="0"
                    Click="HotkeyButton_Click"/>
        </Grid>
    </Grid>
</Window>